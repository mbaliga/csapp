<resources xmlns:tools="http://schemas.android.com/tools">
    <string name="app_name">csapp</string>

    <!-- Home-screen widgets. A home screen is public: titles and counts only, never reviewer names,
         email addresses, or review / mail text. Glyph + word for every state; colour never alone. -->
    <string name="widget_loading">Loading…</string>
    <!-- How fresh the synced data is (the last pass in which every source of every set-up channel worked). -->

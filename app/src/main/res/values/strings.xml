    <string name="widget_open_empty">Nothing open</string>
    <plurals name="widget_open_count">
        <item quantity="one">open incident</item>
        <item quantity="other">open incidents</item>
    </plurals>

    <!-- Incidents (list) -->
    <string name="widget_list_name">Incidents</string>
    <string name="widget_list_desc">The most severe open incidents, with severity, status and project. Titles only. Tap one to open it.</string>
    <string name="widget_list_empty">Nothing open</string>

    <!-- Top incident (card) -->
    <string name="widget_top_name">Top incident</string>
    <string name="widget_top_desc">The most severe open incident: its title, severity, status and where its signals came from. Tap to open it.</string>

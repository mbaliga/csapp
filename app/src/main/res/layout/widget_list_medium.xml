<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen widget layout (RemoteViews: LinearLayout + TextView only). See docs/widgets.md. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:clipToOutline="true"
    android:padding="@dimen/widget_padding"
    tools:ignore="UnusedAttribute">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/w_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="12sp"
            android:textColor="@color/widget_accent"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:textAlignment="viewStart" />
        <TextView
            android:id="@+id/w_asof"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textSize="12sp"
            android:textColor="@color/widget_muted"
            android:maxLines="1"
            android:ellipsize="end"
            android:textAlignment="viewStart"
            android:visibility="gone" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/w_row_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="3dp"
        android:paddingBottom="3dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="true">
            <TextView
                android:id="@+id/w_row_1_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="14sp"
                android:textColor="@color/widget_text"
                android:maxLines="1"
                android:ellipsize="end"
                android:textAlignment="viewStart" />
            <TextView
                android:id="@+id/w_row_1_trail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textSize="14sp"
                android:textColor="@color/widget_text"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:textAlignment="viewStart" />
        </LinearLayout>
        <TextView
            android:id="@+id/w_row_1_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="@color/widget_muted"
            android:maxLines="1"
            android:ellipsize="end"
            android:textAlignment="viewStart" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/w_row_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="3dp"
        android:paddingBottom="3dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="true">
            <TextView
                android:id="@+id/w_row_2_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="14sp"
                android:textColor="@color/widget_text"
                android:maxLines="1"
                android:ellipsize="end"
                android:textAlignment="viewStart" />
            <TextView
                android:id="@+id/w_row_2_trail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textSize="14sp"
                android:textColor="@color/widget_text"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:textAlignment="viewStart" />
        </LinearLayout>
        <TextView
            android:id="@+id/w_row_2_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="@color/widget_muted"
            android:maxLines="1"
            android:ellipsize="end"
            android:textAlignment="viewStart" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/w_row_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="3dp"
        android:paddingBottom="3dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="true">
            <TextView
                android:id="@+id/w_row_3_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="14sp"
                android:textColor="@color/widget_text"
                android:maxLines="1"
                android:ellipsize="end"
                android:textAlignment="viewStart" />
            <TextView
                android:id="@+id/w_row_3_trail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textSize="14sp"
                android:textColor="@color/widget_text"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:textAlignment="viewStart" />
        </LinearLayout>
        <TextView
            android:id="@+id/w_row_3_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="@color/widget_muted"
            android:maxLines="1"
            android:ellipsize="end"
            android:textAlignment="viewStart" />
    </LinearLayout>
    <TextView
        android:id="@+id/w_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textSize="14sp"
        android:textColor="@color/widget_muted"
        android:maxLines="2"
        android:ellipsize="end"
        android:textAlignment="viewStart"
        android:visibility="gone" />
</LinearLayout>

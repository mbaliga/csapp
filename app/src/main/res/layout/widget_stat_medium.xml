<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen widget layout (RemoteViews: LinearLayout + TextView only). See docs/widgets.md. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:clipToOutline="true"
    android:padding="@dimen/widget_padding"
    tools:ignore="UnusedAttribute">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/w_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="12sp"
            android:textColor="@color/widget_accent"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:textAlignment="viewStart" />
        <TextView
            android:id="@+id/w_asof"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textSize="12sp"
            android:textColor="@color/widget_muted"
            android:maxLines="1"
            android:ellipsize="end"
            android:textAlignment="viewStart"
            android:visibility="gone" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="2dp"
        android:baselineAligned="true">
        <TextView
            android:id="@+id/w_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="28sp"
            android:textColor="@color/widget_text"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:textAlignment="viewStart" />
        <TextView
            android:id="@+id/w_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:textSize="14sp"
            android:textColor="@color/widget_text"
            android:maxLines="2"
            android:ellipsize="end"
            android:textAlignment="viewStart" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/w_cells"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="6dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false">
            <LinearLayout
                android:id="@+id/w_cell_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:baselineAligned="true">
                <TextView
                    android:id="@+id/w_cell_1_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:textColor="@color/widget_text"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textAlignment="viewStart" />
                <TextView
                    android:id="@+id/w_cell_1_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:textSize="12sp"
                    android:textColor="@color/widget_text"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textAlignment="viewStart" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/w_cell_2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:baselineAligned="true">
                <TextView
                    android:id="@+id/w_cell_2_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:textColor="@color/widget_text"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textAlignment="viewStart" />
                <TextView
                    android:id="@+id/w_cell_2_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:textSize="12sp"
                    android:textColor="@color/widget_text"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textAlignment="viewStart" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:layout_marginTop="2dp">
            <LinearLayout
                android:id="@+id/w_cell_3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:baselineAligned="true">
                <TextView
                    android:id="@+id/w_cell_3_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:textColor="@color/widget_text"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textAlignment="viewStart" />
                <TextView
                    android:id="@+id/w_cell_3_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:textSize="12sp"
                    android:textColor="@color/widget_text"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textAlignment="viewStart" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/w_cell_4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:baselineAligned="true">
                <TextView
                    android:id="@+id/w_cell_4_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:textColor="@color/widget_text"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textAlignment="viewStart" />
                <TextView
                    android:id="@+id/w_cell_4_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:textSize="12sp"
                    android:textColor="@color/widget_text"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textAlignment="viewStart" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:id="@+id/w_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textSize="14sp"
        android:textColor="@color/widget_muted"
        android:maxLines="2"
        android:ellipsize="end"
        android:textAlignment="viewStart"
        android:visibility="gone" />
</LinearLayout>
